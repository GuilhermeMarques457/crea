using CREA.Application.Interfaces.Repositories;
using CREA.Domain.Entities;
using CREA.Infrastructure;
using Microsoft.EntityFrameworkCore;

namespace CREA.Insfrastructure.Repositories;

public class LogAuditoriaRepository(ApplicationDbContext context) : Repository<LogAuditoria>(context), ILogAuditoriaRepository
{
    public async Task<IEnumerable<LogAuditoria>> GetByUsuarioAsync(Guid usuarioId) =>
        await _dbSet
            .Where(l => l.UsuarioId == usuarioId)
            .OrderByDescending(l => l.DataAcao)
            .ToListAsync();

    public async Task<IEnumerable<LogAuditoria>> GetByEntidadeAsync(string entidade, string entidadeId) =>
        await _dbSet
            .Where(l => l.Entidade == entidade && l.EntidadeId == entidadeId)
            .OrderByDescending(l => l.DataAcao)
            .ToListAsync();

    public async Task<IEnumerable<LogAuditoria>> GetByPeriodoAsync(DateTime inicio, DateTime fim) =>
        await _dbSet
            .Where(l => l.DataAcao >= inicio && l.DataAcao <= fim)
            .OrderByDescending(l => l.DataAcao)
            .ToListAsync();
}
