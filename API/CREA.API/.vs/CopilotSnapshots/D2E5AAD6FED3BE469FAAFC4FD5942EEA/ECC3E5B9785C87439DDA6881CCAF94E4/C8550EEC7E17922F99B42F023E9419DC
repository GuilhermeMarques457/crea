@import "tailwindcss";
@import "@angular/material/prebuilt-themes/azure-blue.css";

:root {
  --primary: #1565C0;
  --primary-light: #1E88E5;
  --accent: #FF8F00;
  --warn: #D32F2F;
  --surface: #F8FAFC;
  --border: #E2E8F0;
}

* { font-family: 'Inter', sans-serif; box-sizing: border-box; }

html, body { height: 100%; margin: 0; background: var(--surface); }

.mat-mdc-card { border-radius: 12px !important; }
.page-container { padding: 24px; max-width: 1400px; margin: 0 auto; }
.mat-mdc-snack-bar-container.success-snack { --mdc-snackbar-container-color: #1B5E20; }
.mat-mdc-snack-bar-container.error-snack { --mdc-snackbar-container-color: #B71C1C; }
