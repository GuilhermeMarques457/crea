<div class="page-container">
  @if (loading()) {
    <div class="flex justify-center py-16"><mat-spinner /></div>
  } @else if (obra()) {
    <app-page-header
      [title]="obra()!.nome"
      [subtitle]="obra()!.cidade + '/' + obra()!.estado"
      icon="construction"
    >
      <div class="flex gap-2">
        <button mat-button [routerLink]="['/obras', obra()!.id, 'editar']">
          <mat-icon>edit</mat-icon> Editar
        </button>
        <button mat-button routerLink="/obras"><mat-icon>arrow_back</mat-icon> Voltar</button>
      </div>
    </app-page-header>

    <!-- Info Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-6">
      <mat-card class="lg:col-span-2">
        <mat-card-content class="p-5">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <p class="text-xs text-slate-500 uppercase tracking-wide">Status</p>
              <app-status-badge [status]="obra()!.status" class="mt-1" />
            </div>
            <div>
              <p class="text-xs text-slate-500 uppercase tracking-wide">Tipo</p>
              <p class="font-medium text-slate-800">{{ tipoLabel() }}</p>
            </div>
            <div>
              <p class="text-xs text-slate-500 uppercase tracking-wide">Proprietário</p>
              <p class="font-medium text-slate-800">{{ obra()!.proprietario }}</p>
            </div>
            <div>
              <p class="text-xs text-slate-500 uppercase tracking-wide">ART</p>
              <p class="font-medium text-slate-800">{{ obra()!.numeroArt }}</p>
            </div>
            <div>
              <p class="text-xs text-slate-500 uppercase tracking-wide">Início</p>
              <p class="font-medium text-slate-800">
                {{ obra()!.dataInicio | date: 'dd/MM/yyyy' }}
              </p>
            </div>
            <div>
              <p class="text-xs text-slate-500 uppercase tracking-wide">Previsão Término</p>
              <p class="font-medium text-slate-800">
                {{ (obra()!.dataPrevisaoTermino | date: 'dd/MM/yyyy') ?? '–' }}
              </p>
            </div>
            <div class="col-span-2">
              <p class="text-xs text-slate-500 uppercase tracking-wide">Endereço</p>
              <p class="font-medium text-slate-800">{{ obra()!.endereco }}</p>
            </div>
          </div>
        </mat-card-content>
      </mat-card>

      <mat-card>
        <mat-card-content class="p-5">
          <p class="text-xs text-slate-500 uppercase tracking-wide mb-3">Responsável Técnico</p>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
              <mat-icon class="text-blue-600">engineering</mat-icon>
            </div>
            <div>
              <p class="font-semibold text-slate-800">{{ obra()!.nomeProfissionalResponsavel }}</p>
            </div>
          </div>
          <mat-divider class="mb-4" />
          <p class="text-xs text-slate-500 uppercase tracking-wide my-3">Alterar Status</p>
          <div class="flex flex-wrap gap-2">
            @for (s of statusOptions; track s.value) {
              <button
                mat-stroked-button
                [disabled]="obra()!.status === s.value"
                (click)="mudarStatus(s.value)"
                class="text-xs"
              >
                {{ s.label }}
              </button>
            }
          </div>
        </mat-card-content>
      </mat-card>
    </div>

    <!-- Tabs -->
    <mat-card>
      <mat-tab-group>
        <!-- Registros Diários -->
        <mat-tab label="Registros Diários ({{ registros().length }})">
          <div class="p-5">
            <div class="flex justify-end mb-4">
              <a
                mat-flat-button
                color="primary"
                [routerLink]="['/obras', obra()!.id, 'registros', 'novo']"
              >
                <mat-icon>add</mat-icon> Novo Registro
              </a>
            </div>
            @if (registros().length === 0) {
              <app-empty-state icon="edit_note" message="Sem registros diários" />
            } @else {
              <div class="space-y-3">
                @for (r of registros(); track r.id) {
                  <div class="border border-slate-200 rounded-lg p-4 hover:bg-slate-50">
                    <div class="flex items-center justify-between mb-2">
                      <p class="font-semibold text-slate-800">{{ r.data | date: 'dd/MM/yyyy' }}</p>
                      <div class="flex items-center gap-2">
                        <span class="text-xs bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full">
                          {{ r.totalAssinaturas }} assinatura(s)
                        </span>
                        <a mat-icon-button [routerLink]="['/registros', r.id, 'editar']">
                          <mat-icon class="text-lg">edit</mat-icon>
                        </a>
                      </div>
                    </div>
                    <p class="text-sm text-slate-600 line-clamp-2">{{ r.atividades }}</p>
                    <p class="text-xs text-slate-400 mt-1">Equipe: {{ r.equipePresente }}</p>
                  </div>
                }
              </div>
            }
          </div>
        </mat-tab>

        <!-- Ocorrências -->
        <mat-tab label="Ocorrências ({{ ocorrencias().length }})">
          <div class="p-5">
            <div class="flex justify-end mb-4">
              <a
                mat-flat-button
                color="primary"
                [routerLink]="['/obras', obra()!.id, 'ocorrencias', 'nova']"
              >
                <mat-icon>add</mat-icon> Nova Ocorrência
              </a>
            </div>
            @if (ocorrencias().length === 0) {
              <app-empty-state icon="report_problem" message="Sem ocorrências registradas" />
            } @else {
              <div class="space-y-3">
                @for (oc of ocorrencias(); track oc.id) {
                  <div class="border border-slate-200 rounded-lg p-4 hover:bg-slate-50">
                    <div class="flex items-center justify-between mb-1">
                      <p class="font-semibold text-slate-800">{{ oc.titulo }}</p>
                      <span class="text-xs bg-orange-100 text-orange-700 px-2 py-0.5 rounded-full">
                        {{ tipoOcorrenciaLabel(oc) }}
                      </span>
                    </div>
                    <p class="text-sm text-slate-600 line-clamp-2">{{ oc.descricao }}</p>
                    <p class="text-xs text-slate-400 mt-1">
                      {{ oc.dataOcorrencia | date: 'dd/MM/yyyy' }}
                    </p>
                  </div>
                }
              </div>
            }
          </div>
        </mat-tab>

        <!-- Anexos -->
        <mat-tab label="Anexos ({{ anexos().length }})">
          <div class="p-5">
            <div class="flex justify-center mb-4 border-1 p-12 rounded-xl">
              <label mat-flat-button color="primary" class="cursor-pointer">
                <mat-icon>upload</mat-icon> Upload
                <input type="file" class="hidden" (change)="uploadAnexo($event)" />
              </label>
            </div>
            @if (anexos().length === 0) {
              <app-empty-state icon="attach_file" message="Sem anexos" />
            } @else {
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                @for (a of anexos(); track a.id) {
                  <div class="border border-slate-200 rounded-lg p-3 flex items-center gap-3">
                    <mat-icon class="text-slate-400 shrink-0">insert_drive_file</mat-icon>
                    <div class="min-w-0 flex-1">
                      <p class="text-sm font-medium text-slate-700 truncate">
                        {{ a.nomeArquivoOriginal }}
                      </p>
                      <p class="text-xs text-slate-400">
                        {{ (a.tamanhoBytes / 1024).toFixed(1) }} KB
                      </p>
                    </div>
                    <a [href]="a.urlDownload" target="_blank" mat-icon-button>
                      <mat-icon class="text-lg">download</mat-icon>
                    </a>
                  </div>
                }
              </div>
            }
          </div>
        </mat-tab>

        <!-- Termo de Conclusão -->
        <mat-tab label="Termo de Conclusão">
          <div class="p-5">
            @if (termo()) {
              <div class="bg-green-50 border border-green-200 rounded-xl p-5">
                <div class="flex items-center gap-3 mb-4">
                  <mat-icon class="text-green-600 text-3xl">verified</mat-icon>
                  <div>
                    <p class="font-bold text-green-800 text-lg">Obra Concluída</p>
                    <p class="text-sm text-green-700">
                      Termo emitido em {{ termo()!.criadoEm | date: 'dd/MM/yyyy' }}
                    </p>
                  </div>
                </div>
                <div class="grid grid-cols-2 gap-3 text-sm">
                  <div>
                    <span class="text-slate-500">Data conclusão:</span>
                    <span class="font-medium ml-1">{{
                      termo()!.dataConclusao | date: 'dd/MM/yyyy'
                    }}</span>
                  </div>
                  <div>
                    <span class="text-slate-500">Profissional:</span>
                    <span class="font-medium ml-1">{{ termo()!.nomeProfissional }}</span>
                  </div>
                </div>
                <p class="text-sm text-slate-700 mt-3">{{ termo()!.descricao }}</p>
              </div>
            } @else {
              <app-empty-state
                icon="description"
                message="Sem termo de conclusão"
                description="Emita o termo ao concluir a obra"
              >
                <a
                  mat-flat-button
                  color="primary"
                  class="mt-4"
                  [routerLink]="['/obras', obra()!.id, 'termo']"
                >
                  <mat-icon>add</mat-icon> Emitir Termo
                </a>
              </app-empty-state>
            }
          </div>
        </mat-tab>
      </mat-tab-group>
    </mat-card>
  }
</div>
