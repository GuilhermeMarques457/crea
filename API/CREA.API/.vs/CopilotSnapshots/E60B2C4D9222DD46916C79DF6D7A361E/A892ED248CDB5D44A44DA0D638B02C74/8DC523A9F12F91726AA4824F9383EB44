<div class="page-container">
  <app-page-header title="Usuários" subtitle="Gerencie os usuários do sistema" icon="group">
    <a mat-flat-button color="primary" routerLink="/usuarios/novo">
      <mat-icon>add</mat-icon> Novo Usuário
    </a>
  </app-page-header>

  <mat-card class="mb-4">
    <mat-card-content class="p-4">
      <mat-form-field appearance="outline" class="w-full max-w-sm">
        <mat-label>Buscar</mat-label>
        <mat-icon matPrefix>search</mat-icon>
        <input matInput [(ngModel)]="search" placeholder="Nome ou e-mail..." />
      </mat-form-field>
    </mat-card-content>
  </mat-card>

  @if (loading()) {
    <div class="flex justify-center py-16"><mat-spinner /></div>
  } @else if (filtered().length === 0) {
    <app-empty-state icon="group" message="Nenhum usuário encontrado" />
  } @else {
    <mat-card>
      <mat-card-content class="p-0">
        <div class="overflow-x-auto">
          <table mat-table [dataSource]="filtered()" class="w-full">
            <ng-container matColumnDef="nome">
              <th
                mat-header-cell
                *matHeaderCellDef
                class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase"
              >
                Usuário
              </th>
              <td mat-cell *matCellDef="let u" class="px-4 py-3">
                <div class="flex items-center gap-3">
                  <div
                    class="w-9 h-9 bg-purple-100 rounded-full flex items-center justify-center font-bold text-purple-700 text-sm shrink-0"
                  >
                    {{ u.nome.charAt(0) }}
                  </div>
                  <div>
                    <p class="font-medium text-slate-800">{{ u.nome }}</p>
                    <p class="text-xs text-slate-500">{{ u.email }}</p>
                  </div>
                </div>
              </td>
            </ng-container>
            <ng-container matColumnDef="tipo">
              <th
                mat-header-cell
                *matHeaderCellDef
                class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase"
              >
                Tipo
              </th>
              <td mat-cell *matCellDef="let u" class="px-4 py-3 text-sm text-slate-600">
                {{ tipoLabel(u) }}
              </td>
            </ng-container>
            <ng-container matColumnDef="status">
              <th
                mat-header-cell
                *matHeaderCellDef
                class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase"
              >
                Status
              </th>
              <td mat-cell *matCellDef="let u" class="px-4 py-3">
                <span
                  [class]="u.ativo ? 'bg-green-100 text-green-800' : 'bg-slate-100 text-slate-600'"
                  class="px-2.5 py-0.5 rounded-full text-xs font-medium"
                >
                  {{ u.ativo ? 'Ativo' : 'Inativo' }}
                </span>
              </td>
            </ng-container>
            <ng-container matColumnDef="criadoEm">
              <th
                mat-header-cell
                *matHeaderCellDef
                class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase"
              >
                Cadastrado
              </th>
              <td mat-cell *matCellDef="let u" class="px-4 py-3 text-sm text-slate-500">
                {{ u.criadoEm | date: 'dd/MM/yyyy' }}
              </td>
            </ng-container>
            <ng-container matColumnDef="acoes">
              <th mat-header-cell *matHeaderCellDef class="px-4 py-3"></th>
              <td mat-cell *matCellDef="let u" class="px-4 py-3">
                <button mat-icon-button [matMenuTriggerFor]="menu">
                  <mat-icon>more_vert</mat-icon>
                </button>
                <mat-menu #menu>
                  <a mat-menu-item [routerLink]="['/usuarios', u.id, 'editar']">
                    <mat-icon>edit</mat-icon> Editar
                  </a>
                  <button mat-menu-item (click)="confirmarExcluir(u)">
                    <mat-icon class="text-red-600">delete</mat-icon>
                    <span class="text-red-600">Excluir</span>
                  </button>
                </mat-menu>
              </td>
            </ng-container>
            <tr mat-header-row *matHeaderRowDef="columns" class="bg-slate-50"></tr>
            <tr
              mat-row
              *matRowDef="let row; columns: columns"
              class="hover:bg-slate-50 border-b border-slate-100"
            ></tr>
          </table>
        </div>
      </mat-card-content>
    </mat-card>
  }
</div>
