<div class="page-container">
  <app-page-header
    title="Auditoria"
    subtitle="Histórico de todas as alterações realizadas no sistema"
    icon="security"
  />

  <!-- Filtros -->
  <mat-card class="mb-6">
    <mat-card-content class="p-5">
      <form [formGroup]="form" (ngSubmit)="filtrar()" class="flex flex-wrap items-end gap-4">
        <mat-form-field appearance="outline" class="min-w-44">
          <mat-label>Entidade</mat-label>
          <mat-select formControlName="entidade">
            <mat-option value="">Todas</mat-option>
            @for (e of entidades; track e) {
              <mat-option [value]="e">{{ e }}</mat-option>
            }
          </mat-select>
        </mat-form-field>

        <mat-form-field appearance="outline" class="min-w-40">
          <mat-label>Ação</mat-label>
          <mat-select formControlName="acao">
            <mat-option value="">Todas</mat-option>
            @for (a of acoes; track a) {
              <mat-option [value]="a">{{ a }}</mat-option>
            }
          </mat-select>
        </mat-form-field>

        <mat-form-field appearance="outline" class="min-w-44">
          <mat-label>Data início</mat-label>
          <input matInput type="datetime-local" formControlName="inicio" />
        </mat-form-field>

        <mat-form-field appearance="outline" class="min-w-44">
          <mat-label>Data fim</mat-label>
          <input matInput type="datetime-local" formControlName="fim" />
        </mat-form-field>

        <div class="flex gap-2 pb-5">
          <button mat-flat-button color="primary" type="submit" [disabled]="loading()">
            <mat-icon>search</mat-icon> Filtrar
          </button>
          <button mat-stroked-button type="button" (click)="limparFiltros()" [disabled]="loading()">
            <mat-icon>clear</mat-icon> Limpar
          </button>
        </div>
      </form>
    </mat-card-content>
  </mat-card>

  <!-- Tabela -->
  <mat-card>
    <mat-card-content class="p-0">
      @if (loading()) {
        <div class="flex justify-center items-center py-16">
          <mat-spinner diameter="40" />
        </div>
      } @else {
        <div class="overflow-x-auto">
          <table mat-table [dataSource]="result()?.items ?? []" class="w-full">
            <ng-container matColumnDef="dataAcao">
              <th mat-header-cell *matHeaderCellDef class="whitespace-nowrap">Data / Hora</th>
              <td mat-cell *matCellDef="let log" class="whitespace-nowrap text-sm">
                {{ log.dataAcao | date: 'dd/MM/yyyy HH:mm:ss' }}
              </td>
            </ng-container>

            <ng-container matColumnDef="nomeUsuario">
              <th mat-header-cell *matHeaderCellDef>Usuário</th>
              <td mat-cell *matCellDef="let log" class="text-sm font-medium">
                {{ log.nomeUsuario }}
              </td>
            </ng-container>

            <ng-container matColumnDef="acao">
              <th mat-header-cell *matHeaderCellDef>Ação</th>
              <td mat-cell *matCellDef="let log">
                <mat-chip [color]="acaoColor(log.acao)" highlighted>{{ log.acao }}</mat-chip>
              </td>
            </ng-container>

            <ng-container matColumnDef="entidade">
              <th mat-header-cell *matHeaderCellDef>Entidade</th>
              <td mat-cell *matCellDef="let log" class="text-sm">{{ log.entidade }}</td>
            </ng-container>

            <ng-container matColumnDef="entidadeId">
              <th mat-header-cell *matHeaderCellDef>ID</th>
              <td mat-cell *matCellDef="let log">
                <span class="text-xs font-mono text-slate-400" [matTooltip]="log.entidadeId ?? ''">
                  {{ log.entidadeId ? (log.entidadeId | slice: 0 : 8) + '…' : '–' }}
                </span>
              </td>
            </ng-container>

            <ng-container matColumnDef="enderecoIp">
              <th mat-header-cell *matHeaderCellDef>IP</th>
              <td mat-cell *matCellDef="let log" class="text-xs font-mono text-slate-500">
                {{ log.enderecoIp ?? '–' }}
              </td>
            </ng-container>

            <ng-container matColumnDef="detalhes">
              <th mat-header-cell *matHeaderCellDef>Detalhes</th>
              <td mat-cell *matCellDef="let log">
                @if (log.dadosAntigos || log.dadosNovos) {
                  <button mat-icon-button color="primary" (click)="abrirDetalhes(log)" matTooltip="Ver detalhes">
                    <mat-icon>visibility</mat-icon>
                  </button>
                } @else {
                  <span class="text-xs text-slate-400">–</span>
                }
              </td>
            </ng-container>

            <tr mat-header-row *matHeaderRowDef="displayedColumns"></tr>
            <tr
              mat-row
              *matRowDef="let row; columns: displayedColumns"
              class="hover:bg-slate-50 transition-colors"
            ></tr>

            <tr class="mat-row" *matNoDataRow>
              <td [attr.colspan]="displayedColumns.length" class="text-center py-12 text-slate-400">
                <mat-icon class="text-4xl block mx-auto mb-2">search_off</mat-icon>
                Nenhum registro encontrado.
              </td>
            </tr>
          </table>
        </div>

        <mat-paginator
          [length]="result()?.totalItems ?? 0"
          [pageSize]="pageSize()"
          [pageIndex]="page() - 1"
          [pageSizeOptions]="[10, 20, 50, 100]"
          (page)="onPage($event)"
          showFirstLastButtons
        />
      }
    </mat-card-content>
  </mat-card>
</div>
