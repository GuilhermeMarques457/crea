<h2 mat-dialog-title class="flex items-center gap-2">
  <mat-icon>info</mat-icon> Detalhes da Alteração
</h2>
<mat-dialog-content class="min-w-[500px] max-h-[70vh]">
  @if (temDiferencas) {
    <div class="flex items-center gap-2 mb-4">
      <mat-slide-toggle
        [checked]="apenaDiferencas()"
        (change)="apenaDiferencas.set($event.checked)"
        color="primary"
      >
        Apenas diferenças
      </mat-slide-toggle>
    </div>
  }

  @if (apenaDiferencas()) {
    @if (antigosDiffFormatado) {
      <p class="text-sm font-semibold text-slate-600 mb-1">
        Antes <span class="font-normal text-xs text-slate-400">(campos alterados)</span>
      </p>
      <pre class="text-xs bg-red-50 rounded p-3 overflow-auto whitespace-pre-wrap break-all mb-4">{{ antigosDiffFormatado }}</pre>
    }
    @if (novosDiffFormatado) {
      <p class="text-sm font-semibold text-slate-600 mb-1">
        Depois <span class="font-normal text-xs text-slate-400">(campos alterados)</span>
      </p>
      <pre class="text-xs bg-green-50 rounded p-3 overflow-auto whitespace-pre-wrap break-all">{{ novosDiffFormatado }}</pre>
    }
    @if (!antigosDiffFormatado && !novosDiffFormatado) {
      <p class="text-sm text-slate-500">Nenhuma diferença encontrada.</p>
    }
  } @else {
    @if (antigosFormatado) {
      <p class="text-sm font-semibold text-slate-600 mb-1">Antes:</p>
      <pre class="text-xs bg-red-50 rounded p-3 overflow-auto whitespace-pre-wrap break-all mb-4">{{ antigosFormatado }}</pre>
    }
    @if (novosFormatado) {
      <p class="text-sm font-semibold text-slate-600 mb-1">Depois:</p>
      <pre class="text-xs bg-green-50 rounded p-3 overflow-auto whitespace-pre-wrap break-all">{{ novosFormatado }}</pre>
    }
  }
</mat-dialog-content>
<mat-dialog-actions align="end">
  <button mat-flat-button mat-dialog-close color="primary">Fechar</button>
</mat-dialog-actions>
