<div class="page-container max-w-3xl">
  <app-page-header
    [title]="isEdit() ? 'Editar Registro Diário' : 'Novo Registro Diário'"
    subtitle="Registre as atividades do dia (Relato de Visita)"
    icon="edit_note"
  >
    <button mat-button (click)="voltar()"><mat-icon>arrow_back</mat-icon> Voltar</button>
  </app-page-header>

  <mat-card>
    <mat-card-content class="p-6">
      <form [formGroup]="form" (ngSubmit)="submit()">
        <h3 class="text-base font-semibold text-slate-700 mb-4">Informações do Dia</h3>
        <div class="space-y-4 mb-6">
          <mat-form-field appearance="outline" class="w-full">
            <mat-label>Data</mat-label>
            <input matInput [matDatepicker]="dp" formControlName="data" />
            <mat-datepicker-toggle matSuffix [for]="dp" />
            <mat-datepicker #dp />
            <mat-error>Data é obrigatória</mat-error>
          </mat-form-field>
          <mat-form-field appearance="outline" class="w-full">
            <mat-label>Atividades Realizadas</mat-label>
            <textarea matInput formControlName="atividades" rows="4" placeholder="Descreva as atividades realizadas no dia..."></textarea>
            <mat-error>Atividades são obrigatórias</mat-error>
          </mat-form-field>
          <mat-form-field appearance="outline" class="w-full">
            <mat-label>Equipe Presente</mat-label>
            <input matInput formControlName="equipePresente" placeholder="Ex: João, Maria, Pedro..." />
            <mat-error>Equipe presente é obrigatória</mat-error>
          </mat-form-field>
          <mat-form-field appearance="outline" class="w-full">
            <mat-label>Condição Climática</mat-label>
            <input matInput formControlName="condicaoClimatica" placeholder="Ex: Ensolarado, Chuvoso..." />
          </mat-form-field>
          <mat-form-field appearance="outline" class="w-full">
            <mat-label>Observações</mat-label>
            <textarea matInput formControlName="observacoes" rows="3"></textarea>
          </mat-form-field>
        </div>

        <h3 class="text-base font-semibold text-slate-700 mb-4">Etapas da Obra</h3>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-2 mb-6">
          <mat-checkbox formControlName="servicosPreliminar" color="primary">Serviços Preliminares</mat-checkbox>
          <mat-checkbox formControlName="fundacao" color="primary">Fundação</mat-checkbox>
          <mat-checkbox formControlName="alvenarias" color="primary">Alvenarias</mat-checkbox>
          <mat-checkbox formControlName="superestrutura" color="primary">Superestrutura</mat-checkbox>
          <mat-checkbox formControlName="cobertura" color="primary">Cobertura</mat-checkbox>
          <mat-checkbox formControlName="esquadriasInstalacoesEletricasHidraulicas" color="primary">Esquadrias / Inst. Elétricas e Hidráulicas</mat-checkbox>
          <mat-checkbox formControlName="revestimentoForroParePiso" color="primary">Revestimento (forro, parede, piso)</mat-checkbox>
          <mat-checkbox formControlName="pintura" color="primary">Pintura</mat-checkbox>
          <mat-checkbox formControlName="servicosComplementares" color="primary">Serviços Complementares</mat-checkbox>
        </div>

        <h3 class="text-base font-semibold text-slate-700 mb-4">Posição da Obra</h3>
        <div class="space-y-4 mb-6">
          <mat-form-field appearance="outline" class="w-full">
            <mat-label>Posição da Obra</mat-label>
            <mat-select formControlName="posicaoObra">
              <mat-option [value]="null">—</mat-option>
              @for (p of posicaoObraOptions; track p.value) {
                <mat-option [value]="p.value">{{ p.label }}</mat-option>
              }
            </mat-select>
          </mat-form-field>
          <mat-form-field appearance="outline" class="w-full">
            <mat-label>Decisões técnicas e orientações executivas</mat-label>
            <textarea matInput formControlName="decisoesTecnicas" rows="3" placeholder="Registre as decisões técnicas..."></textarea>
          </mat-form-field>
        </div>

        <h3 class="text-base font-semibold text-slate-700 mb-4">Assinatura do Proprietário / Construtor</h3>
        <div class="mb-6">
          <mat-form-field appearance="outline" class="w-full">
            <mat-label>Nome do assinante (proprietário ou construtor)</mat-label>
            <input matInput formControlName="assinaturaProprietario" />
          </mat-form-field>
        </div>

        <div class="flex justify-end gap-3">
          <button mat-button type="button" (click)="voltar()">Cancelar</button>
          <button mat-flat-button color="primary" type="submit" [disabled]="saving()">
            @if (saving()) {
              <mat-spinner diameter="18" class="inline-block mr-2"></mat-spinner>
            }
            {{ saving() ? 'Salvando...' : isEdit() ? 'Salvar' : 'Registrar' }}
          </button>
        </div>
      </form>
    </mat-card-content>
  </mat-card>
</div>
