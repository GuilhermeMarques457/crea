<div class="page-container">
  <app-page-header
    title="Pendências"
    subtitle="Termos de conclusão aguardando sua assinatura"
    icon="pending_actions"
  />

  @if (loading()) {
    <div class="flex justify-center py-16"><mat-spinner /></div>
  } @else if (pendentes().length === 0) {
    <app-empty-state
      icon="check_circle"
      message="Nenhuma pendência"
      description="Todos os termos estão assinados."
    />
  } @else {
    <div class="space-y-4">
      @for (t of pendentes(); track t.id) {
        <mat-card>
          <mat-card-content class="p-5">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-2">
                  <mat-icon class="text-orange-500">description</mat-icon>
                  <a
                    [routerLink]="['/obras', t.obraId]"
                    class="text-lg font-semibold text-slate-800 hover:text-blue-600 no-underline"
                  >
                    {{ t.nomeObra }}
                  </a>
                </div>
                <p class="text-sm text-slate-600 mb-2">{{ t.descricao }}</p>
                <div class="flex flex-wrap gap-4 text-xs text-slate-500">
                  <span
                    ><strong>Conclusão:</strong> {{ t.dataConclusao | date: 'dd/MM/yyyy' }}</span
                  >
                  <span><strong>Profissional:</strong> {{ t.nomeProfissional }}</span>
                  <span><strong>Emitido em:</strong> {{ t.criadoEm | date: 'dd/MM/yyyy' }}</span>
                </div>

                <div class="mt-3 flex items-center gap-2">
                  <span
                    class="text-xs px-2.5 py-1 rounded-full font-medium"
                    [class]="
                      t.assinadoPeloResponsavel
                        ? 'bg-green-100 text-green-700'
                        : 'bg-yellow-100 text-yellow-700'
                    "
                  >
                    Responsável: {{ t.assinadoPeloResponsavel ? 'Assinado ✓' : 'Pendente' }}
                  </span>
                  <span
                    class="text-xs px-2.5 py-1 rounded-full font-medium"
                    [class]="
                      t.assinadoPeloAdmin
                        ? 'bg-green-100 text-green-700'
                        : 'bg-yellow-100 text-yellow-700'
                    "
                  >
                    Administrador: {{ t.assinadoPeloAdmin ? 'Assinado ✓' : 'Pendente' }}
                  </span>
                </div>

                @if (t.assinaturas.length > 0) {
                  <div class="mt-3 text-xs text-slate-400">
                    @for (a of t.assinaturas; track a.id) {
                      <div class="flex items-center gap-1">
                        <p>
                          {{ a.nomeUsuario }} ({{ a.tipoAssinante }}) —
                          {{ a.dataAssinatura | date: 'dd/MM/yyyy HH:mm' }}
                        </p>
                        @if (a.imagemAssinatura) {
                          <button mat-icon-button class="!w-10 !h-10" (click)="verAssinatura(a)">
                            <mat-icon class="text-blue-600 !text-md">draw</mat-icon>
                          </button>
                        }
                      </div>
                    }
                  </div>
                }
              </div>

              @if (podeAssinar(t)) {
                <button mat-flat-button color="primary" (click)="assinar(t)">
                  <mat-icon>draw</mat-icon> Assinar
                </button>
              }
            </div>
          </mat-card-content>
        </mat-card>
      }
    </div>
  }
</div>
