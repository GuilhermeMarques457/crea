import { Injectable, inject } from '@angular/core';
import { HttpClient } from '@angular/common/http';
import { TermoConclusaoDto, CreateTermoConclusaoDto } from '../../shared/models/api.models';
import { environment } from '../../../environments/environment';

@Injectable({ providedIn: 'root' })
export class TermoConclusaoService {
  private readonly http = inject(HttpClient);
  private readonly base = `${environment.apiUrl}/api/TermosConclusao`;

  porObra(obraId: string) {
    return this.http.get<TermoConclusaoDto>(`${this.base}/por-obra/${obraId}`);
  }
  obter(id: string) {
    return this.http.get<TermoConclusaoDto>(`${this.base}/${id}`);
  }
  criar(dto: CreateTermoConclusaoDto) {
    return this.http.post<TermoConclusaoDto>(this.base, dto);
  }
  assinar(termoId: string) {
    return this.http.post<TermoConclusaoDto>(`${this.base}/${termoId}/assinar`, {});
  }
  pendentes() {
    return this.http.get<TermoConclusaoDto[]>(`${this.base}/pendentes`);
  }
  meusPendentes() {
    return this.http.get<TermoConclusaoDto[]>(`${this.base}/meus-pendentes`);
  }
  excluir(id: string) {
    return this.http.delete<void>(`${this.base}/${id}`);
  }
}
