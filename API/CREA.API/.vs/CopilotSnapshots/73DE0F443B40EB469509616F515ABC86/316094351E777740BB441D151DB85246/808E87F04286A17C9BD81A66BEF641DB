<div class="page-container">
  <app-page-header
    title="Relatórios"
    subtitle="Gere relatórios detalhados das obras"
    icon="assessment"
  />

  <mat-card class="mb-6 no-print">
    <mat-card-content class="p-5">
      <form [formGroup]="form" (ngSubmit)="gerar()" class="flex flex-wrap gap-4">
        <mat-form-field appearance="outline" class="flex-1 min-w-64">
          <mat-label>Selecione a Obra</mat-label>
          <mat-select formControlName="obraId">
            @for (o of obras(); track o.id) {
              <mat-option [value]="o.id">{{ o.nome }} – {{ o.cidade }}/{{ o.estado }}</mat-option>
            }
          </mat-select>
        </mat-form-field>
        <button
          mat-flat-button
          color="primary"
          type="submit"
          [disabled]="loading() || form.invalid"
          class="h-14"
        >
          @if (loading()) {
            <mat-spinner diameter="18" class="inline-block mr-2"></mat-spinner>
          }
          <mat-icon>assessment</mat-icon> Gerar Relatório
        </button>
      </form>
    </mat-card-content>
  </mat-card>

  @if (relatorio()) {
    <div class="space-y-4" id="relatorio-print">
      <!-- Header -->
      <mat-card class="bg-gradient-to-r from-blue-700 to-blue-900 text-white">
        <mat-card-content class="p-6">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-2xl font-bold">{{ relatorio()!.nomeObra }}</h2>
              <p class="opacity-80 mt-1">
                {{ relatorio()!.endereco }} – {{ relatorio()!.cidade }}/{{ relatorio()!.estado }}
              </p>
            </div>
            <div class="text-right">
              <app-status-badge [status]="relatorio()!.status" />
              <p class="text-xs opacity-70 mt-2">
                Gerado em {{ relatorio()!.geradoEm | date: 'dd/MM/yyyy HH:mm' }}
              </p>
              <button
                mat-stroked-button
                class="mt-3 no-print !text-white !border-white"
                (click)="exportarPdf()"
              >
                <mat-icon>picture_as_pdf</mat-icon> Exportar PDF
              </button>
            </div>
          </div>
        </mat-card-content>
      </mat-card>

      <!-- Estatísticas -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        @for (stat of statCards(); track stat.label) {
          <mat-card>
            <mat-card-content class="p-4 text-center">
              <p class="text-3xl font-bold text-blue-700">{{ stat.value }}</p>
              <p class="text-sm text-slate-500 mt-1">{{ stat.label }}</p>
            </mat-card-content>
          </mat-card>
        }
      </div>

      <!-- Detalhes -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <mat-card>
          <mat-card-header><mat-card-title>Dados da Obra</mat-card-title></mat-card-header>
          <mat-card-content class="p-4 space-y-2 text-sm">
            <div class="flex justify-between mt-2">
              <span class="text-slate-500">Proprietário</span
              ><span class="font-medium">{{ relatorio()!.proprietario }}</span>
            </div>
            <mat-divider />
            <div class="flex justify-between mt-2">
              <span class="text-slate-500">ART</span
              ><span class="font-medium font-mono">{{ relatorio()!.numeroArt }}</span>
            </div>
            <mat-divider />
            <div class="flex justify-between mt-2">
              <span class="text-slate-500">Tipo</span
              ><span class="font-medium">{{ tipoLabel() }}</span>
            </div>
            <mat-divider />
            <div class="flex justify-between mt-2">
              <span class="text-slate-500">Início</span
              ><span class="font-medium">{{ relatorio()!.dataInicio | date: 'dd/MM/yyyy' }}</span>
            </div>
            @if (relatorio()!.dataPrevisaoTermino) {
              <mat-divider />
              <div class="flex justify-between mt-2">
                <span class="text-slate-500">Previsão Término</span
                ><span class="font-medium">{{
                  relatorio()!.dataPrevisaoTermino | date: 'dd/MM/yyyy'
                }}</span>
              </div>
            }
          </mat-card-content>
        </mat-card>

        <mat-card>
          <mat-card-header><mat-card-title>Responsável Técnico</mat-card-title></mat-card-header>
          <mat-card-content class="p-4 space-y-2 text-sm">
            <div class="flex justify-between mt-2">
              <span class="text-slate-500">Nome</span
              ><span class="font-medium">{{ relatorio()!.nomeProfissionalResponsavel }}</span>
            </div>
            <mat-divider />
            <div class="flex justify-between mt-2">
              <span class="text-slate-500">Registro</span
              ><span class="font-medium font-mono">{{
                relatorio()!.numeroRegistroProfissional
              }}</span>
            </div>
            <mat-divider />
            <div class="flex justify-between mt-2">
              <span class="text-slate-500">Termo de Conclusão</span>
              <span
                [class]="
                  relatorio()!.possuiTermoConclusao
                    ? 'text-green-600 font-medium'
                    : 'text-slate-400'
                "
              >
                {{ relatorio()!.possuiTermoConclusao ? 'Emitido' : 'Pendente' }}
              </span>
            </div>
          </mat-card-content>
        </mat-card>
      </div>

      <!-- Assinaturas do Termo -->
      @if (relatorio()!.possuiTermoConclusao) {
        <mat-card>
          <mat-card-header
            ><mat-card-title>Assinaturas do Termo de Conclusão</mat-card-title></mat-card-header
          >
          <mat-card-content class="p-4">
            <div class="flex flex-wrap gap-2 mb-4">
              <span
                class="text-xs px-2.5 py-1 rounded-full font-medium"
                [class]="
                  relatorio()!.assinadoPeloResponsavel
                    ? 'bg-green-100 text-green-700'
                    : 'bg-yellow-100 text-yellow-700'
                "
              >
                Responsável Técnico:
                {{ relatorio()!.assinadoPeloResponsavel ? 'Assinado ✓' : 'Pendente' }}
              </span>
              <span
                class="text-xs px-2.5 py-1 rounded-full font-medium"
                [class]="
                  relatorio()!.assinadoPeloAdmin
                    ? 'bg-green-100 text-green-700'
                    : 'bg-yellow-100 text-yellow-700'
                "
              >
                Administrador: {{ relatorio()!.assinadoPeloAdmin ? 'Assinado ✓' : 'Pendente' }}
              </span>
              <span
                class="text-xs px-2.5 py-1 rounded-full font-medium"
                [class]="
                  relatorio()!.termoConcluido
                    ? 'bg-green-100 text-green-700'
                    : 'bg-orange-100 text-orange-700'
                "
              >
                {{
                  relatorio()!.termoConcluido ? 'Termo Concluído ✓' : 'Assinatura(s) Pendente(s)'
                }}
              </span>
            </div>
            @if (relatorio()!.assinaturas.length > 0) {
              <div class="divide-y divide-slate-100">
                @for (a of relatorio()!.assinaturas; track a.id) {
                  <div class="py-2 flex justify-between text-sm">
                    <div>
                      <span class="font-medium text-slate-800">{{ a.nomeUsuario }}</span>
                      <span class="text-xs text-slate-500 ml-2">({{ a.tipoAssinante }})</span>
                    </div>
                    <span class="text-slate-500">{{
                      a.dataAssinatura | date: 'dd/MM/yyyy HH:mm'
                    }}</span>
                  </div>
                }
              </div>
            } @else {
              <p class="text-sm text-slate-500">Nenhuma assinatura realizada ainda.</p>
            }
          </mat-card-content>
        </mat-card>
      }

      <!-- Registros Diários -->
      @if (relatorio() != null && relatorio()!.registrosDiarios!.length) {
        <mat-card>
          <mat-card-header><mat-card-title>Registros Diários</mat-card-title></mat-card-header>
          <mat-card-content class="p-0">
            <div class="divide-y divide-slate-100">
              @for (r of relatorio()!.registrosDiarios; track r.id) {
                <div class="px-5 py-3">
                  <div class="flex justify-between mb-1">
                    <span class="font-medium text-slate-800">{{
                      r.data | date: 'dd/MM/yyyy'
                    }}</span>
                    <span class="text-xs text-blue-600 font-medium"
                      >{{ r.totalAssinaturas }} assinatura(s)</span
                    >
                  </div>
                  <p class="text-sm text-slate-600">{{ r.atividades }}</p>
                  <p class="text-xs text-slate-400 mt-1">Equipe: {{ r.equipePresente }}</p>
                </div>
              }
            </div>
          </mat-card-content>
        </mat-card>
      }

      <!-- Ocorrências -->
      @if (relatorio() != null && relatorio()!.ocorrencias!.length) {
        <mat-card>
          <mat-card-header><mat-card-title>Ocorrências</mat-card-title></mat-card-header>
          <mat-card-content class="p-0">
            <div class="divide-y divide-slate-100">
              @for (oc of relatorio()!.ocorrencias; track oc.id) {
                <div class="px-5 py-3">
                  <div class="flex justify-between mb-1">
                    <span class="font-medium text-slate-800">{{ oc.titulo }}</span>
                    <span class="text-xs text-orange-600 font-medium">{{
                      oc.dataOcorrencia | date: 'dd/MM/yyyy'
                    }}</span>
                  </div>
                  <p class="text-sm text-slate-600">{{ oc.descricao }}</p>
                </div>
              }
            </div>
          </mat-card-content>
        </mat-card>
      }
    </div>
  }
</div>
