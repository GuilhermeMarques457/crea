<div class="page-container max-w-3xl">
  <app-page-header
    [title]="isEdit() ? 'Editar Obra' : 'Nova Obra'"
    [subtitle]="isEdit() ? 'Altere os dados da obra' : 'Preencha os dados para cadastrar'"
    icon="construction"
  >
    <button mat-button (click)="voltar()"><mat-icon>arrow_back</mat-icon> Voltar</button>
  </app-page-header>

  <mat-card>
    <mat-card-content class="p-6">
      <form [formGroup]="form" (ngSubmit)="submit()">
        <h3 class="text-base font-semibold text-slate-700 mb-4">Informações Básicas</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
          <mat-form-field appearance="outline" class="md:col-span-2">
            <mat-label>Nome da Obra</mat-label>
            <input matInput formControlName="nome" />
            <mat-error>Nome é obrigatório</mat-error>
          </mat-form-field>
          <mat-form-field appearance="outline" class="md:col-span-2">
            <mat-label>Endereço</mat-label>
            <input matInput formControlName="endereco" />
            <mat-error>Endereço é obrigatório</mat-error>
          </mat-form-field>
          <mat-form-field appearance="outline">
            <mat-label>Cidade</mat-label>
            <input matInput formControlName="cidade" />
            <mat-error>Cidade é obrigatória</mat-error>
          </mat-form-field>
          <div class="grid grid-cols-2 gap-4">
            <mat-form-field appearance="outline">
              <mat-label>Estado (UF)</mat-label>
              <input matInput formControlName="estado" maxlength="2" />
              <mat-error>UF obrigatório</mat-error>
            </mat-form-field>
            <mat-form-field appearance="outline">
              <mat-label>CEP</mat-label>
              <input matInput formControlName="cep" placeholder="00000-000" />
            </mat-form-field>
          </div>
        </div>

        <h3 class="text-base font-semibold text-slate-700 mb-4">Dados Técnicos</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
          <mat-form-field appearance="outline">
            <mat-label>Proprietário</mat-label>
            <input matInput formControlName="proprietario" />
            <mat-error>Proprietário é obrigatório</mat-error>
          </mat-form-field>
          <mat-form-field appearance="outline">
            <mat-label>Número ART</mat-label>
            <input matInput formControlName="numeroArt" />
            <mat-error>ART é obrigatória</mat-error>
          </mat-form-field>
          <mat-form-field appearance="outline">
            <mat-label>Tipo de Obra</mat-label>
            <mat-select formControlName="tipoObra">
              @for (t of tipoObraOptions; track t.value) {
                <mat-option [value]="t.value">{{ t.label }}</mat-option>
              }
            </mat-select>
            <mat-error>Tipo é obrigatório</mat-error>
          </mat-form-field>
          <mat-form-field appearance="outline">
            <mat-label>Profissional Responsável</mat-label>
            <mat-select formControlName="profissionalResponsavelId">
              @for (p of profissionais(); track p.id) {
                <mat-option [value]="p.id">{{ p.nome }} – {{ p.numeroRegistro }}</mat-option>
              }
            </mat-select>
            <mat-error>Profissional é obrigatório</mat-error>
          </mat-form-field>
          <mat-form-field appearance="outline">
            <mat-label>Data de Início</mat-label>
            <input matInput [matDatepicker]="dpInicio" formControlName="dataInicio" />
            <mat-datepicker-toggle matSuffix [for]="dpInicio" />
            <mat-datepicker #dpInicio />
            <mat-error>Data de início é obrigatória</mat-error>
          </mat-form-field>
          <mat-form-field appearance="outline">
            <mat-label>Previsão de Término</mat-label>
            <input matInput [matDatepicker]="dpFim" formControlName="dataPrevisaoTermino" />
            <mat-datepicker-toggle matSuffix [for]="dpFim" />
            <mat-datepicker #dpFim />
          </mat-form-field>
        </div>

        <mat-form-field appearance="outline" class="w-full mb-6">
          <mat-label>Descrição</mat-label>
          <textarea
            matInput
            formControlName="descricao"
            rows="3"
            placeholder="Descreva a obra..."
          ></textarea>
        </mat-form-field>

        <div class="flex justify-end gap-3">
          <button mat-button type="button" (click)="voltar()">Cancelar</button>
          <button mat-flat-button color="primary" type="submit" [disabled]="saving()">
            @if (saving()) {
              <mat-spinner diameter="18" class="inline-block mr-2"></mat-spinner>
            }
            {{ saving() ? 'Salvando...' : isEdit() ? 'Salvar Alterações' : 'Cadastrar Obra' }}
          </button>
        </div>
      </form>
    </mat-card-content>
  </mat-card>
</div>
